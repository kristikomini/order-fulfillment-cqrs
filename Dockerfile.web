# Multi-stage build for the LogiFlow Blazor UI
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/LogiFlow.Web/LogiFlow.Web.csproj
RUN dotnet publish src/LogiFlow.Web/LogiFlow.Web.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app .
EXPOSE 8080
ENTRYPOINT ["dotnet", "LogiFlow.Web.dll"]
